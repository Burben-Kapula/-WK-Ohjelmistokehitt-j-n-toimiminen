# Server
PORT=3000
NODE_ENV=development

# Admin credentials (bcrypt hash of the admin password; never store plaintext)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=          # generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"

# JWT (use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Upload limits
MAX_FILE_SIZE=5242880          # 5 MB
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Email (Resend) — order notifications
RESEND_API_KEY=                # get one at https://resend.com/api-keys
ORDER_NOTIFICATION_EMAIL=maksym.kapula@gmail.com
MAIL_FALLBACK_TO=              # allowed recipient while in Resend test mode
MAIL_FROM=K.Betoniveistokset <onboarding@resend.dev>